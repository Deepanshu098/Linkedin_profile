# Application Configuration
PORT=3000
NODE_ENV=development

# LinkedIn Session Cookies
# Extract these from your browser Developer Tools (Application -> Cookies -> linkedin.com)
# 1. li_at: Core session identifier
# 2. JSESSIONID: CSRF verification token (usually starts with "ajax:...")
#
# Note: If these are left blank/undefined, the server will automatically default
# to the deterministic Mock/Fallback provider, allowing immediate out-of-the-box testing.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=
